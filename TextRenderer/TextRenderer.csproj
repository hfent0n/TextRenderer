<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
        <PackageReference Include="SixLabors.Fonts" Version="3.2.0" />
        <PackageReference Include="System.IO.Hashing" Version="10.0.14" />
    </ItemGroup>

    <ItemGroup>
        <!-- Fonts served by the registry, copied to bin/.../fonts (PLAN_PART_2 decision 11). -->
        <None Include="..\fonts\*.ttf" Link="fonts\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

</Project>
